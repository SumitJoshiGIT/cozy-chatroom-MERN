GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/oauth/callback

DATABASE=mongodb://localhost:27017/Lavendar
SESSION_SECRET=

# Comma-separated. Every origin that serves the client must be listed: sockets
# and POST requests from anywhere else are refused.
CLIENT_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
DEMO_ENABLED=false
DEMO_TTL_HOURS=24

# LiveKit calls
# Development defaults work with `docker compose up livekit`.
# Replace these values for production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

EMAIL_USER=
EMAIL_PASS=

# Web push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Attempts per IP per window on /auth routes (default 30)
# AUTH_RATE_LIMIT=30
